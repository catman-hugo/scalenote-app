{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: core features, closing the window after saving, choosing a folder, and opening the ScaleNote releases page, and a file of a release, in the browser.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/catman-hugo/scalenote-app/releases"
        },
        {
          "url": "https://github.com/catman-hugo/scalenote-app/releases/*"
        },
        {
          "url": "https://github.com/catman-hugo/scalenote-app/releases/download/*/*"
        }
      ]
    }
  ]
}
