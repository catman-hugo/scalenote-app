[Unit]
Description=ScaleNote home server (syncs notes between your own devices)
After=network-online.target
Wants=network-online.target

[Service]
User=scalenote
ExecStart=/usr/local/bin/scalenote-server run --config /etc/scalenote-server.conf
Restart=on-failure
RestartSec=5
# The server only needs its data folder and the vault folders. Change the second path to match
# the folders in the config.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scalenote-server /srv/scalenote

[Install]
WantedBy=multi-user.target
